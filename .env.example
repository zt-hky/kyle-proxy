# Optional Telegram control bot
# Create a bot with @BotFather. Leave both values empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_ACCESS_PATH=/data/telegram-access.json

# Optional GitHub OAuth protection for the Web UI
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_USERS=
# AUTH_SECRET=
# PUBLIC_URL=http://localhost:8888
